# ==============================================================================
# TextilePay Payroll System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In Vercel, configure these variables in Settings -> Environment Variables.
# NEVER commit your actual .env or .env.local file to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT RUNTIME (Required for Vite & Vercel)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anonymous API Key (safe for browser exposure)
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# ------------------------------------------------------------------------------
# 2. LOCAL BOOTSTRAP / OWNER CREATION (Optional - used by scripts/create-owner.mjs)
# ------------------------------------------------------------------------------
# NEVER expose the SERVICE_ROLE_KEY to the browser or commit it to GitHub.
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# OWNER_EMAIL=admin@yourtextilecompany.com
# OWNER_PASSWORD=YourSecurePassword123!
# OWNER_NAME=Administrator
# OWNER_USERNAME=admin
# COMPANY_NAME="Textile Mills Pvt Ltd"
# COMPANY_SLUG=textile-mills

# Razorpay Subscriptions (configure these as Supabase Edge Function secrets,
# not as VITE_* variables or frontend environment variables)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_PLAN_ID=plan_...
# RAZORPAY_WEBHOOK_SECRET=...
